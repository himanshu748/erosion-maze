{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "erosion-maze",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "entry": "launch.html", "height": "tall" },
      "game": { "entry": "game.html" }
    }
  },
  "server": { "dir": "dist/server", "entry": "index.cjs" },
  "menu": {
    "items": [
      {
        "label": "Open practice maze",
        "description": "Create a post that opens the local-practice maze.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/practice"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily": { "endpoint": "/internal/scheduler/daily", "cron": "1 0 * * *" },
      "catchup": {
        "endpoint": "/internal/scheduler/daily",
        "cron": "17 * * * *"
      }
    }
  },
  "permissions": {
    "http": { "enable": false },
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scripts": { "dev": "vite build --watch", "build": "npm run build" }
}
